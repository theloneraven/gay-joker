import("SCRIPTCHAT_1314.msg");

void chatProc_hook()
{
    
    if (CHAT_CHECK_READ(-1) == 0)
    {
        CHAT_WND_DSP();
    }

    CHAT_MAIN();
    
    if (CHAT_CHECK_SWITCH(-1) == 1)
    {
        
        if (BIT_CHK(4863) == 1)
        {
            RYUJI_EVENT_FROM_CHAT();
        }

    }

}

void CHAT_MAIN_hook()
{
    int month;
    int day;
    int commuId;
    int var6;
    int selChoice;
    month = CHAT_GET_ARRIVAL_MONTH(-1);
    day = CHAT_GET_ARRIVAL_DAY(-1);
    commuId = 8;
    MSG(MSG_000_0_0, 0);
    MSG(MSG_002_0_0, 0);
    
    if ((month == 11) && (day >= 24))
    {
        MSG(MSG_001_0_0, 0);
    }
    else if ((month == 12) && (day <= 17))
    {
        MSG(MSG_001_0_0, 0);
    }
    else 
    {
        MSG(MSG_001_1_0, 0);
    }

    
    if (CHAT_CHECK_READ(-1) == 1)
    {
        CHAT_SEL_LINE(13, 0);
        MSG(CHAT_REACTION_01, 0);
        MSG(CHAT_REACTION_02, 0);
        MSG(CHAT_REACTION_03, 0);
        CHAT_WND_DSP();
        CHAT_WAIT_PAD();
    }

    
    if ((GET_DAY() == day) && (GET_MONTH() == month))
    {
        
        if ((GET_TIME() == 4) || (GET_TIME() == 3))
        {
            CMM_VSET_COMMUNITY(commuId);
            
            if (CMM_CHK_ARCANA_PSSTOCKLV(commuId) != 0)
            {
                COOP_DOUZOKUSEI_MSG();
            }

            var6 = 1;
            _20_3:
            
            if (var6 == 1)
            {
                COOP_FIRST_RANKUP_MSG();
                
                if ((month == 11) && (day >= 24))
                {
                    MSG_WND_DSP();
                    MSG(MSG_CORP_PLAY_CHECK2, 0);
                }
                else if ((month == 12) && (day <= 17))
                {
                    MSG_WND_DSP();
                    MSG(MSG_CORP_PLAY_CHECK2, 0);
                }
                else 
                {
                    MSG_WND_DSP();
                    MSG(MSG_CORP_PLAY_CHECK1, 0);
                }

                SEL_DEFKEY(14, 2);
                selChoice = SEL(SEL_001);
                MSG_WND_CLS();
                
                if (selChoice == 0)
                {
                    CHAT_SET_SEL(-1, 0, 0);
                    CHAT_SEL_LINE(13, 0);
                    MSG(CHAT_REACTION_01, 0);
                    MSG(CHAT_REACTION_02, 0);
                    MSG(CHAT_REACTION_03, 0);
                    CHAT_SET_SWITCH(-1, 1);
                    CHAT_WND_CLS();
                    CHAT_SET_HOLD(-1, 0);
                    BIT_ON(4863);
                    return;
                }
                else if (selChoice == 1)
                {
                    CALL_CONF_COOPERATION(commuId, CMM_GET_LV(commuId));
                }
                else if (selChoice == 2)
                {
                    CHAT_WND_CLS();
                    CHAT_SET_HOLD(-1, 1);
                    return;
                }

                goto _20_3;
            }

        }
        else if (GET_TIME() == 0)
        {
            CHAT_SET_HOLD(-1, 1);
            Holiday_ChatNotSend();
        }

    }

    CHAT_WND_CLS();
}

void Holiday_ChatNotSend()
{
    MSG_WND_DSP();
    MSG_MIND(MND_CHAT_INVITE_STOP, 0);
    MSG_WND_CLS();
    CHAT_RESERVE_END();
}


