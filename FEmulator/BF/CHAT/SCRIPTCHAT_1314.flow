void RYUJI_EVENT_FROM_CHAT()
{
    int eventMinor;
    int var15;
    int commuId;
    int rank;
    int rankPlusOne;
    eventMinor = 300;
    var15 = 0;
    commuId = 8;

    rank = CMM_GET_LV(commuId);
    CHAT_RESERVE_END();
    CMM_SETUP_EVENT(0, commuId);
    CMM_LVUP(commuId);
    rankPlusOne = CMM_GET_LV(commuId);
    BIT_OFF(4071);
    BIT_ON(4390);
    
    if (BIT_CHK(3785))
    {
        BIT_ON(1288);
    }

    NET_SET_AFTER_SCHOOL_ACTION(8);
    if (BIT_CHK(164) == 1)
    {
        SET_COUNT(369, 4);
    }

    HERO_CHAT_CLOSE();
    Fld_FadeOut_CallEvent();
    CMM_EXEC_EVENT();
    
    if ((BIT_CHK(3784) == 1) && (BIT_CHK(3785) == 0))
    {
        BIT_ON(3785);
    }

        
    if (BIT_CHK(3785) == 1)
    {
        CALL_EVENT(707, 101);
    }

    
    if (var15 == 1)
    {
        TROPHY_REQUEST(116, 0);
    }

    
    if (CMM_CHK_RANKUP_EVENT_NEXT(8, rank) == 1)
    {
        
        if (CMM_CHK_INSERT_EVENT_RUBURAN(8, rank) == 1)
        {
            eventMinor = 310;
        }

        CALL_EVENT(700, eventMinor);
    }

    BIT_OFF(4896);
    BIT_OFF(1288);
    CALL_CALENDAR();
    BIT_OFF(4863);
    return;
}

