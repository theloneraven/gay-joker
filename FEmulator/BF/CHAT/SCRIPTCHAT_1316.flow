    if (CHAT_CHECK_SWITCH(-1) == 0)
    {
        
        if ((GET_DAY() == month) && (GET_MONTH() == day))
        {
            
            if (GET_TIME() == 5)
            {
                var10 = 1;
                _13_5:
                
                if (var10 == 1)
                {
