// Procedure Index: 1
void e754_120_01()
{
    int valentinesEventMinor;
    valentinesEventMinor = GET_COUNT(352);
    
    if (150 == valentinesEventMinor)
    {
        EVT_SET_LOCAL_DATA(47, 0);
    }
    else if (BIT_CHK(3793)
        || BIT_CHK(3792)
        || BIT_CHK(3794)
        || BIT_CHK(3796)
        || BIT_CHK(3797)
        || BIT_CHK(3798)
        || BIT_CHK(3799)
        || BIT_CHK(3800)
        || BIT_CHK(3785)    // ryuji
        || BIT_CHK(3789)    // yusuke
    {
        EVT_SET_LOCAL_DATA(47, 2);
    }
    else 
    {
        EVT_SET_LOCAL_DATA(47, 1);
    }

}


