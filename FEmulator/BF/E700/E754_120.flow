// Procedure Index: 3
void dbg_0214_state_select()
{
    int selChoice;
    
    if (CHK_DAYS(4, 1))
    {
        MSG_WND_DSP();
        MSG(MND_0214_STATE_SELECT, 10);
        selChoice = SEL(SEL_0214_STATE_SELECT_DB);
        MSG_WND_CLS();
        
        if (selChoice == 0)
        {
            SET_COUNT(352, 150);
        }
        else if (selChoice == 1)
        {
            SET_COUNT(352, 90);
        }
        else 
        {
            SET_COUNT(352, 1090);
        }

    }

    return;
}

