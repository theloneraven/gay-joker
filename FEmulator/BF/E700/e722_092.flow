void lover_check_hook()
{
    if (BIT_CHK(3793)
        || BIT_CHK(3792)
        || BIT_CHK(3794)
        || BIT_CHK(3796)
        || BIT_CHK(3797)
        || BIT_CHK(3798)
        || BIT_CHK(3799)
        || BIT_CHK(3800)
        || BIT_CHK(3785)    // ryuji
        || BIT_CHK(3789)    // yusuke
        || BIT_CHK(3791))   // mishima
    {
        EVT_SET_LOCAL_DATA(47, 1);
    }
    else 
    {
        EVT_SET_LOCAL_DATA(47, 0);
    }
}