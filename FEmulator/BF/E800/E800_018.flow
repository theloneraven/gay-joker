// Procedure Index: 0
void e800_004_init()
{
    int weather;
    weather = GET_WEATHER();
    
    if (weather == 1)
    {
        BIT_OFF(3825);
    }
    else 
    {
        BIT_OFF(3825);
    }

    
    if (CMM_GET_LV(19) == 1)
    {
        MESSAGE_REF(1, 0);
        BIT_ON(3824);
    }
    else if (CMM_GET_LV(19) == 2)
    {
        MESSAGE_REF(1, 4);
        BIT_ON(3826);
    }
    else if (CMM_GET_LV(19) == 3)
    {
        MESSAGE_REF(1, 8);
        BIT_ON(3827);
    }
    else if (CMM_GET_LV(19) == 4)
    {
        MESSAGE_REF(1, 12);
        BIT_ON(3828);
    }
    else if (CMM_GET_LV(19) == 5)
    {
        MESSAGE_REF(1, 0x10);
        BIT_ON(3829);
    }
    else if (CMM_GET_LV(19) == 6)
    {
        MESSAGE_REF(1, 20);
        BIT_ON(3830);
        BIT_ON(3835);
    }
    else if (CMM_GET_LV(19) == 7)
    {
        MESSAGE_REF(1, 24);
        BIT_ON(3831);
        BIT_ON(3835);
    }
    else if (CMM_GET_LV(19) == 8)
    {
        MESSAGE_REF(1, 28);
        BIT_ON(3832);
    }
    else if (CMM_GET_LV(19) == 9)
    {
        MESSAGE_REF(1, 0x20);
        BIT_ON(3833);
    }
    else if (CMM_GET_LV(19) == 10)
    {
        MESSAGE_REF(1, 36);
        BIT_ON(3834);
    }

    return;
}


// Procedure Index: 1
void e800_004_callgift()
{
    SET_COUNT(63, 5);
    MAIN_GIFT();
    return;
}


// Procedure Index: 2
void e800_004_endinit()
{
    BIT_OFF(3824);
    BIT_OFF(3825);
    BIT_OFF(3826);
    BIT_OFF(3827);
    BIT_OFF(3828);
    BIT_OFF(3829);
    BIT_OFF(3830);
    BIT_OFF(3831);
    BIT_OFF(3832);
    BIT_OFF(3833);
    BIT_OFF(3834);
    BIT_OFF(3835);
    BIT_OFF(3836);
    BIT_OFF(3837);
    BIT_OFF(3838);
    BIT_OFF(3839);
    SET_COUNT(63, 0);
    BIT_OFF(4606);
    return;
}


// Procedure Index: 3
void e800_004_item_hit()
{
    GET_ITEM_WINDOW((0x3000 + 460), 1, 0);
    SET_ITEM_NUM((0x3000 + 460), (GET_ITEM_NUM((0x3000 + 460)) + 1));
    return;
}


// Procedure Index: 4
void e800_004_item_hit2()
{
    GET_ITEM_WINDOW((0x3000 + 457), 1, 0);
    SET_ITEM_NUM((0x3000 + 457), (GET_ITEM_NUM((0x3000 + 457)) + 1));
    BIT_ON(2231);
    return;
}


// Procedure Index: 5
void e800_004_item_hit3()
{
    GET_ITEM_WINDOW((0x3000 + 452), 1, 0);
    SET_ITEM_NUM((0x3000 + 452), (GET_ITEM_NUM((0x3000 + 452)) + 1));
    return;
}


// Procedure Index: 6
void e800_002_rank_up_announce_before()
{
    
    if (CMM_CHK_LVUP(19))
    {
        EVT_SET_LOCAL_DATA(47, 1);
    }

    return;
}


// Procedure Index: 7
void e800_002_rank_up_announce_after()
{
    
    if (CMM_CHK_LVUP(19))
    {
        MSG_WND_DSP();
        MSG_MIND(MND_RANK_UP_ANNOUNCE_18, 0);
        MSG_WND_CLS();
    }

    return;
}


// Procedure Index: 8
void MAIN_GIFT()
{
    INIT_ITEM_SELECT();
    SUB_GIFT_ITEM_CHK();
    
    if (giftItemsAvailable != 1)
    {
        return;
    }

    itemId = -1;
    commuId = GET_COUNT(63);
    SUB_GIFT_START_MSG();
    itemId = START_ITEM_SELECT(0);
    
    if (itemId == -1)
    {
        MSG_WND_DSP();
        MSG_MIND(MND_CANCEL, 0);
        MSG_WND_CLS();
        return;
    }

    SUB_GIFT_MISHIMA();
    SUB_GIFT_MSGPOINT();
    SUB_GIFT_ITEM_DEC();
    AWARD_REQUEST(28, 0);
    return;
}


