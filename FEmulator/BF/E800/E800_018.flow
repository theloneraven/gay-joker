// Procedure Index: 12
void SUB_GIFT_START_MSG()
{
    int msgId1;
    int msgId2;
    int msgId3;
    int var14;

    if (CMM_GET_LV(19) == 10)
    {
        if (BIT_CHK(3791)) { msgId1 = MND_GIFT_018_100; }
        else { msgId1 = MND_GIFT_018_200; }
    }
    else { msgId1 = MND_GIFT_018_000; }

    msgId2 = MND_GIFT_018_000_5R_0;
    msgId3 = MND_GIFT_018_000_5R_1;
    var14 = MND_GIFT_018_000_5R_2;

    MSG_WND_DSP();
    MSG_MIND(msgId1, 0);
    MSG_WND_CLS();
    MSG_WND_DSP();
    MSG_MIND(msgId2, 0);
    MSG_WND_CLS();
    MSG_WND_DSP();
    MSG_MIND(msgId3, 0);
    MSG_WND_CLS();
}

void SUB_GIFT_MISHIMA()
{
    resHnd1 = EVT_GET_ASSET_RESHND(3);
    resHnd2 = EVT_GET_ASSET_RESHND(4);
    SUB_GIFT_VSET_MSG();

    int itemIdInSection;
    itemIdInSection = itemId - 0x3000;
    switch (itemIdInSection)
    {
    // TODO gift preferences
    case 544: // silver bangle, all guys like this
        msgId4 = MND_GIFT_018_004;
        msgId5 = MND_GIFT_018_005;
        numNewPoints = 50;
    default:
        msgId4 = MND_GIFT_018_010;
        msgId5 = MND_GIFT_018_011;
        numNewPoints = 5;
        break;
    }
}
// Procedure Index: 15
void SUB_GIFT_MSGPOINT()
{
    Fld_FadeOut_CutChange();
    MDL_SET_LOOKAT_POS(resHnd2, FLD_MODEL_GET_X_HELPER_TRANSLATE(resHnd1, 1), FLD_MODEL_GET_Y_HELPER_TRANSLATE(resHnd1, 1), FLD_MODEL_GET_Z_HELPER_TRANSLATE(resHnd1, 1), 0);
    WAIT(30);
    Fld_FadeIn_Default();
    MSG_WND_DSP();
    MSG(msgId4, 0);
    MSG_WND_CLS();
    
    if (numNewPoints > 0)
    {
        CMM_ADD_POINT_ID(commuId, numNewPoints, resHnd2);
    }

    MSG_WND_DSP();
    MSG_MIND(msgId5, 0);
    MSG_WND_CLS();
    return;
}


// Procedure Index: 16
void SUB_GIFT_ITEM_DEC()
{
    
    if (itemId == (0x3000 + 87))
    {
        SET_ITEM_NUM((0x3000 + 87), (GET_ITEM_NUM((0x3000 + 87)) - 1));
    }
    else if (itemId == (0x3000 + 544))
    {
        SET_ITEM_NUM((0x3000 + 544), (GET_ITEM_NUM((0x3000 + 544)) - 1));
    }
    else if (itemId == (0x3000 + 84))
    {
        SET_ITEM_NUM((0x3000 + 84), (GET_ITEM_NUM((0x3000 + 84)) - 1));
    }
    else if (itemId == (0x3000 + 542))
    {
        SET_ITEM_NUM((0x3000 + 542), (GET_ITEM_NUM((0x3000 + 542)) - 1));
    }
    else if (itemId == (0x3000 + 543))
    {
        SET_ITEM_NUM((0x3000 + 543), (GET_ITEM_NUM((0x3000 + 543)) - 1));
    }
    else if (itemId == (0x3000 + 89))
    {
        SET_ITEM_NUM((0x3000 + 89), (GET_ITEM_NUM((0x3000 + 89)) - 1));
    }
    else if (itemId == (0x3000 + 90))
    {
        SET_ITEM_NUM((0x3000 + 90), (GET_ITEM_NUM((0x3000 + 90)) - 1));
    }
    else if (itemId == (0x3000 + 197))
    {
        SET_ITEM_NUM((0x3000 + 197), (GET_ITEM_NUM((0x3000 + 197)) - 1));
