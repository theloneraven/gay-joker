    if (BIT_CHK(12516) == 0)
    {
        EVT_SET_LOCAL_DATA(46, 0);
    }
    else if (BIT_CHK(12516) == 1)
    {
        EVT_SET_LOCAL_DATA(46, 1);
    }

    return;
}

