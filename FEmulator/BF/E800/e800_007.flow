import("e800_007.msg");

void SUB_GIFT_START_MSG_hook()
{
    int msgId1;
    int msgId2;
    int msgId3;
    int var14;

    if (CMM_GET_LV(8) == 10)
    {
        if (BIT_CHK(3785)) { msgId1 = MND_GIFT_007_100; }
        else { msgId1 = MND_GIFT_007_200; }
    }
    else { msgId1 = MND_GIFT_007_000; }

    msgId2 = MND_GIFT_007_000_5R_0;
    msgId3 = MND_GIFT_007_000_5R_1;
    var14 = MND_GIFT_007_000_5R_2;

    MSG_WND_DSP();
    MSG_MIND(msgId1, 0);
    MSG_WND_CLS();
    MSG_WND_DSP();
    MSG_MIND(msgId2, 0);
    MSG_WND_CLS();
    MSG_WND_DSP();
    MSG_MIND(msgId3, 0);
    MSG_WND_CLS();
}