void go_spot_coop_hook()
{
    int commuId;
    int trainFare;
    int eventId;
    int eventMajor;
    int eventMinor;
    int fldMajor;
    int fldMinor;
    int fldSub;
    int entranceId;
    commuId = GET_COUNT(61);
    FLD_SET_LOCAL_COUNT((49152 + 10), 0);
    trainFare = FLD_LMAP_GET_FARE(0);
    
    if (commuId == 8)
    {
        proc_SPOT_SET_RYUJI();
    }
    else if ((commuId == 7) || (commuId == 25))
    {
        proc_SPOT_SET_ANNE();
    }
    else if (commuId == 5)
    {
        proc_SPOT_SET_YUSUKE();
    }
    else if ((commuId == 3) || (commuId == 23))
    {
        proc_SPOT_SET_MAKOTO();
    }
    else if ((commuId == 10) || (commuId == 26))
    {
        proc_SPOT_SET_FUTABA();
    }
    else if ((commuId == 4) || (commuId == 24))
    {
        proc_SPOT_SET_HARU();
    }
    else if ((commuId == 33) || (commuId == 34))
    {
        proc_SPOT_SET_KASUMIRE();
    }
    else if (commuId == 9)
    {
        proc_SPOT_SET_AKECHI();
    }

    SET_COUNT(376, sVar0);
    
    if (BIT_CHK(1008) == 1)
    {
        SYNC();
    }
    else 
    {
        proc_fare();
    }

    FLD_LMAP_FADE(0);
    MSG_WND_DSP();
    MSG(sVar188, 0);
    MSG_WND_CLS();
    Fld_FadeOut_Subway();
    FLD_PANEL_MAP_PROC_END(0);
    eventId = FLD_GET_LOCAL_COUNT((49152 + 10));
    eventMajor = (eventId / 1000);
    eventMinor = REM(eventId, 1000);
    CALL_EVENT(eventMajor, eventMinor);
    TROPHY_REQUEST(116, 0);
    SYNC();
    BIT_OFF(1288);
    BIT_OFF(4896);
    BIT_OFF(4607);
    FLD_SET_LOCAL_COUNT((49152 + 10), 0);
    SET_COUNT(376, 0);
    
    if ((BIT_CHK(5006) == 0) && (BIT_CHK(5005) == 0))
    {
        
        if (CHK_DAYS_STARTEND(4, 1, 4, 3))
        {
            
            if ((commuId == 3) || (commuId == 23))
            {
                
                if (BIT_CHK(3088) == 0)
                {
                    fldMajor = 2;
                    fldMinor = 2;
                    fldSub = 202;
                    entranceId = 2;
                }
                else 
                {
                    fldMajor = 2;
                    fldMinor = 1;
                    fldSub = 202;
                    entranceId = 0;
                }

            }
