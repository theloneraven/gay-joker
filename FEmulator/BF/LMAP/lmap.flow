void lmap_ikebukuro_hook()
{
    int trainFare;
    int commuId;
    int selChoice;
    
    if (BIT_CHK(1008) == 1)
    {
        SYNC();
    }
    else 
    {
        trainFare = FLD_LMAP_GET_FARE(0);
        
        if (ADD_PC_MONEY(0) < (trainFare * 2))
        {
            proc_LMAP_NO_MONEY();
            return;
        }

    }

    
    if (BIT_CHK(4607))
    {
        commuId = GET_COUNT(61);
        MSG_WND_DSP();
        
        if (((commuId == 7) || (commuId == 25)) && BIT_CHK(4522))
        {
            MSG(IKEBUKURO_COMMON_002, 0);
        }
        else if ((commuId == 5) && BIT_CHK(4529))
        {
            MSG(IKEBUKURO_COMMON_003, 0);
        }
        else if (commuId == 9 && BIT_CHK(4456))
        {
            MSG(IKEBUKURO_COMMON_009);
        }
        else 
        {
            MSG(IKEBUKURO_COMMON_000, 0);
        }

        SEL_DEFKEY(14, 1);
        selChoice = SEL(SEL_SPOT_GO);
        MSG_WND_CLS();
        
        if (selChoice == 0)
        {
            sVar0 = 12;
            BIT_ON(10122);
            go_spot_coop();
        }

        return;
    }

    return;
}

