void lmap_odaiba_hook()
{
    int fldMajor;
    int fldMinor;
    int fldSub;
    int trainFare;
    int commuId;
    int selChoice;
    fldMajor = FLD_GET_MAJOR();
    fldMinor = FLD_GET_MINOR();
    fldSub = FLD_GET_DIV_INDEX();
    
    if ((BIT_CHK(1008) == 1) || (BIT_CHK(1039) == 1))
    {
        SYNC();
    }
    else 
    {
        trainFare = FLD_LMAP_GET_FARE(0);
        
        if (ADD_PC_MONEY(0) < (trainFare * 2))
        {
            proc_LMAP_NO_MONEY();
            return;
        }

    }

    
    if (BIT_CHK(4607))
    {
        commuId = GET_COUNT(61);
        MSG_WND_DSP();
        
        if (((commuId == 7) || (commuId == 25)) && BIT_CHK(4526))
        {
            MSG(ODAIBA_COMMON_002, 0);
        }
        else if ((commuId == 3) && BIT_CHK(4541))
        {
            MSG(ODAIBA_COMMON_004, 0);
        }
        else if ((commuId == 23) && BIT_CHK(4543))
        {
            
            if ((GET_WEATHER() == 1) || (GET_WEATHER_DETAIL() == 12))
            {
                MSG(ODAIBA_BAD_WEATHER, 0);
                MSG_WND_CLS();
                return;
            }

            MSG(ODAIBA_COMMON_014, 0);
        }
        else if (((commuId == 10) || (commuId == 26)) && BIT_CHK(4550))
        {
            MSG(ODAIBA_COMMON_005, 0);
        }
        else if (((commuId == 4) || (commuId == 24)) && BIT_CHK(4559))
        {
            MSG(ODAIBA_COMMON_006, 0);
        }
        else if (((commuId == 33) || (commuId == 34)) && BIT_CHK(4654))
        {
            MSG(ODAIBA_COMMON_007, 0);
        }
        else if (commuId == 9 && BIT_CHK(4462))
        {
            MSG(ODAIBA_COMMON_009);
        }
        else if (commuId == 23)
        {
            
            if ((GET_WEATHER() == 1) || (GET_WEATHER_DETAIL() == 12))
            {
                MSG(ODAIBA_BAD_WEATHER, 0);
                MSG_WND_CLS();
                return;
            }

            MSG(ODAIBA_COMMON_999, 0);
        }
        else 
        {
            MSG(ODAIBA_COMMON_000, 0);
        }

        SEL_DEFKEY(14, 1);
        selChoice = SEL(SEL_SPOT_GO);
        MSG_WND_CLS();
        
        if (selChoice == 0)
        {
            sVar0 = 26;
            BIT_ON(10120);
            go_spot_coop();
        }

        return;
    }
    else if (BIT_CHK(1039) == 1)
    {
        
        if ((fldMajor == 20) && (fldMinor == 5))
        {
            Fld_FadeOut_CutChange();
            FLD_PANEL_MAP_PROC_END(0);
            FLD_LOCAL_FLAG_ON((49152 + 2));
            Fld_FadeIn_Default();
        }
        else 
        {
            proc_fare();
            Fld_FadeOut_Subway();
            FLD_PANEL_MAP_PROC_END(0);
            CALL_FIELD(20, 5, 0, 0);
        }

        return;
    }

}

