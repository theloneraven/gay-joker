        }

        SEL_DEFKEY(14, 1);
        selChoice = SEL(SEL_SPOT_GO);
        MSG_WND_CLS();
        
        if (selChoice == 0)
        {
            sVar0 = 33;
            BIT_ON(10127);
            go_spot_coop();
        }

        return;
    }
    else 
    {
        fldMajor = FLD_GET_MAJOR();
        fldMinor = FLD_GET_MINOR();
        fldSub = FLD_GET_DIV_INDEX();
        var167 = 0;
        
        if ((BIT_CHK(6147) == 1) && ((GET_TIME() == 5) || (GET_TIME() == 6)))
        {
            return;
        }
        else if ((BIT_CHK(4915) == 1) && ((GET_TIME() == 5) || (GET_TIME() == 6)))
        {
            return;
        }
        else if (BIT_CHK(10180) && ((GET_TIME() == 5) || (GET_TIME() == 6)))
        {
            return;
        }
        else 
        {
            var165 = 7;
            var166 = 1;
        }

        
        if ((fldMajor == 20) && (fldMinor == 12))
        {
            Fld_FadeOut_CutChange();
            FLD_PANEL_MAP_PROC_END(0);
            FLD_LOCAL_FLAG_ON((49152 + 2));
            Fld_FadeIn_Default();
            return;
        }
        else 
        {
            proc_fare();
            Fld_FadeOut_Subway();
            FLD_PANEL_MAP_PROC_END(0);
            PLAYER_BAG_and_CLOTHES();
            BIT_ON(10127);
            CALL_FIELD(20, 12, 0, 0);
        }

    }

    return;
}

