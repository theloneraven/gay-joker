    {
        commuId = GET_COUNT(61);
        
        if (BIT_CHK(1008) == 1)
        {
            SYNC();
        }
        else 
        {
            trainFare = FLD_LMAP_GET_FARE(0);
            
            if (ADD_PC_MONEY(0) < (trainFare * 2))
            {
                proc_LMAP_NO_MONEY();
                return;
            }

        }

        
        if ((GET_WEATHER() == 1) || (GET_WEATHER_DETAIL() == 12))
        {
            MSG_WND_DSP();
            MSG(MEIJIJINGU_BAD_WEATHER, 0);
            MSG_WND_CLS();
            return;
        }

        MSG_WND_DSP();
        
        if ((commuId == 5) && BIT_CHK(4531))
        {
            MSG(MEIJIJINGU_COMMON_003, 0);
        }
        else if (((commuId == 4) || (commuId == 24)) && BIT_CHK(4561))
        {
            MSG(MEIJIJINGU_COMMON_006, 0);
        }
        else if (((commuId == 33) || (commuId == 34)) && BIT_CHK(4648))
        {
            MSG(MEIJIJINGU_COMMON_007, 0);
        }
        else if (commuId == 9 && BIT_CHK(4464))
        {
            MSG(MEIJIJINGU_COMMON_009);
        }
        else 
