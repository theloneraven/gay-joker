import("../chat_common.flow");
import("corp008.msg");

void SUB_COOP_GENERAL_EVT_CHECK_hook()
{
    int selChoice;
    int hiddenOptionBitfield;
    hiddenOptionBitfield = 0;
    
    if (BIT_CHK(3786))
    {
        SUB_COOP_LMAP_SPOT_CHECK();
        if (sVar1 == 0) { hiddenOptionBitfield = 2; }

        MSG_WND_DSP();
        MSG(MSG_C08_REV_SPOT_00_00, 0);
        selChoice = SEL(SEL_C08_REV_SPOT_00_01);
        MSG_WND_CLS();
            
        if (selChoice == 0)
        {
            sVar2 = 5;
            SUB_COOP_LOVERS_EVT();
        }
        else if (selChoice == 1)
        {
            sVar2 = 2;
            SUB_COOP_SPOT_EVT();
        }
        else 
        {
            sVar2 = 4;
            SUB_COOP_GENERAL_EVT_REV();
        }
    }
    else 
    {
        sVar2 = 4;
        SUB_COOP_GENERAL_EVT();
    }
}

void SUB_COOP_SPOT_EVT_hook()
{
    
    if (BIT_CHK(12048))
    {
        MSG_WND_DSP();
        MSG(MSG_C08_REV_SPOT_00_10, 0);
        MSG_WND_CLS();
    }
    else 
    {
        MSG_WND_DSP();
        MSG(MSG_C08_SPOT_00_10, 0);
        MSG_WND_CLS();
    }

    
    if (!BIT_CHK(4061))
    {
        CALL_TUTORIAL(2, 70);
        BIT_ON(4061);
    }

    Set_CorpPlayNG_ON();
    BIT_ON(4607);
    SET_COUNT(61, sVar0);
    CALL_LMAP(sVar1);
    FLD_PANEL_MAP_PROC_SYNC(0);
    BIT_OFF(4607);
    SET_COUNT(61, 0);
    NightCorpPlayNG_Setup();
}

void SUB_COOP_LMAP_SPOT_CHECK_hook()
{
    
    if (BIT_CHK(10162)      // ueno
        || BIT_CHK(10157)   // ikebukuro
        || BIT_CHK(10159)   // asakusa
        || BIT_CHK(10152)   // shinagawa
        || BIT_CHK(10146)   // tsukishima
        || BIT_CHK(10164)   // maihama
        || BIT_CHK(10161)   // dome town
        || BIT_CHK(10153)   // ferris wheel
        || BIT_CHK(10148)   // jinbocho
        || BIT_CHK(10163))  // meiji shrine
    {
        sVar1 = 39;
    }
    else { sVar1 = 0; }
}

void SUB_BEGIN_MSG_AKECHI_THEATER_hook()
{
    int selChoice;
    MSG_WND_DSP();
    MSG(MSG_C08_BEGIN_D00_10_02, 0);
    
    if (BIT_CHK(5293))
    {
        
        if (BIT_CHK(3787))
        {
            
            if (BIT_CHK(3786))
            {
                SUB_COOP_GENERAL_EVT_CHECK();
            }
            else
            {
                
                if (BIT_CHK(10249) == 0)
                {
                    MSG(MSG_C08_BEGIN_COOPNG_10_, 0);
                }
                else 
                {
                    MSG(MSG_C08_BEGIN_COOPNG_10__2, 0);
                }

            }

        }
        else
        {
            MSG_WND_DSP();
            MSG(MSG_C08_REV_FIGHT_00_01, 0);
            selChoice = SEL(SEL_COOP_REV_FIGHT);
            MSG_WND_CLS();
            
            if (selChoice == 0)
            {
                MSG_WND_DSP();
                MSG(MSG_C08_REV_FIGHT_00_02, 0);
                MSG_WND_CLS();
                SUB_COOP_FIGHT_EVT();
            }
            else 
            {
                MSG_WND_DSP();
                MSG(MSG_C08_REV_FIGHT_00_03, 0);
                MSG_WND_CLS();
            }

        }

    }
    else if (!BIT_CHK(3160))
    {
        
        if (!BIT_CHK(10249))
        {
            MSG(MSG_C08_BEGIN_COOPNG_01_, 0);
        }
        else 
        {
            MSG(MSG_C08_BEGIN_COOPNG_01__2, 0);
        }

    }
    else if (!BIT_CHK(10249))
    {
        MSG(MSG_C08_BEGIN_COOPNG_10_, 0);
    }
    else 
    {
        MSG(MSG_C08_BEGIN_COOPNG_10__2, 0);
    }

    MSG_WND_CLS();
    sVar2 = -1;
}

void SUB_COOP_FIGHT_EVT()
{
    NET_SET_NIGHT_ACTION(93);
    Fld_FadeOut_CallEvent();
    BIT_ON(12308);
    BIT_ON(12310);
    FLD_PARTY_SAVE();
    PARTY_OUT(2);
    PARTY_OUT(3);
    PARTY_OUT(4);
    PARTY_OUT(5);
    PARTY_OUT(6);
    PARTY_OUT(8);
    PARTY_OUT(7);
    PARTY_OUT(9);
    PARTY_OUT(10);
    CALL_EVENTBATTLE(726, 100, 870);
    BIT_ON(3898);
    
    if (!BIT_CHK(11572)) // fight won
    {
        BIT_ON(3787);
        CALL_EVENT(726, 101);
        
        if (BIT_CHK(3786) == 1)
        {
            CALL_EVENT(726, 104);
        }
        else if (BIT_CHK(3786) == 0)
        {
            CALL_EVENT(726, 102);
        }

        BIT_OFF(3997);
        BIT_OFF(4072);
    }
    else 
    {
        CALL_EVENT(726, 103);
        FLD_PARTY_LOAD();
        BIT_OFF(12308);
        BIT_OFF(12310);
        BIT_OFF(12309);
        BIT_OFF(4896);
    }

    FLD_PARTY_LOAD();
    BIT_OFF(12308);
    BIT_OFF(12310);
    BIT_OFF(12309);
    BIT_OFF(4896);
    CALL_CALENDAR();
}

void SUB_COOP_LOVERS_EVT()
{
    MSG_WND_DSP();
    MSG(MSG_C08_MYROOM_00_10_LVR, 0);
    MSG_WND_CLS();
    SUB_COOP_EVT_SET();
    BIT_OFF(6253);
    BIT_ON(1288);
    Fld_FadeOut_CallEvent();
    
    if (!BIT_CHK(4602))
    {
        BIT_ON(4602);
        CALL_EVENT(726, 1);
    }
    else 
    {
        CALL_EVENT(726, 2);
    }

    SUB_COOP_EVT_RESET();
    CALL_CALENDAR();
}

void SUB_COOP_GENERAL_EVT_REV()
{
    NET_SET_NIGHT_ACTION(93);
    BIT_ON(1288);
    MSG_WND_DSP();
    MSG(MSG_C08_YES_10_01, 0);
    MSG(MSG_MORGANA_COOP_ESCAPE, 0);
    MSG_WND_CLS();
    Fld_FadeOut_CallEvent();
    CALL_EVENT(840, 261);
    BIT_OFF(1288);
    CALL_CALENDAR();
    return;
}